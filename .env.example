# ── Provider switch ───────────────────────────────────────────────────────────
# Options: anthropic | openai | deepseek | groq | gemini | ollama
MODEL_PROVIDER=anthropic

# ── Anthropic ─────────────────────────────────────────────────────────────────
# https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── OpenAI ────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── DeepSeek (excellent for code, very cheap) ─────────────────────────────────
# https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-coder

# ── Groq (fast inference, free tier available) ────────────────────────────────
# https://console.groq.com/keys
# Model IDs:
#   openai/gpt-oss-120b      best quality, reasoning, 500 t/s
#   openai/gpt-oss-20b       fastest, cheapest, 1000 t/s
#   llama-3.3-70b-versatile  strong general model, 280 t/s
#   llama-3.1-8b-instant     ultra fast free tier, 560 t/s
#   qwen/qwen3.6-27b         Alibaba, vision capable, 500 t/s
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# ── Google Gemini ─────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ── Ollama (local / self-hosted) ──────────────────────────────────────────────
# Pull a model first: ollama pull qwen2.5-coder:7b
# Note: CPU inference is slow (2-8 min/file). GPU strongly recommended.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ── LangSmith tracing ─────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=llm-code-review-agent

# ── MLflow / DagsHub ──────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=https://dagshub.com/krishnapole90/llm-code-review-agent.mlflow
MLFLOW_TRACKING_USERNAME=krishnapole90
MLFLOW_TRACKING_PASSWORD=your_dagshub_token

# ── AWS (for ECR/ECS deployment) ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=ap-south-2

# ── RAG / ChromaDB ────────────────────────────────────────────────────────────
CHROMA_DB_DIR=./chroma_db

# ── GitHub (raises PR rate limit from 60 to 5000/hour) ───────────────────────
GITHUB_ACCESS_TOKEN=ghp_...

# ── HuggingFace (for sentence-transformers model downloads) ───────────────────
HF_TOKEN=hf_...
